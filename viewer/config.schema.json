{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/choieuihyun/LogLens/viewer/config.schema.json",
  "title": "LogLens viewer config",
  "description": "프로젝트별 도메인 탭 / 이슈 규칙 / 프리픽스. 뷰어를 포크하지 않고 갈아끼우기 위한 파일.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "prefix": {
      "type": "string",
      "default": "APP",
      "description": "logcat 태그 접두사. 태그는 <prefix>_<DOMAIN> 형태여야 한다.",
      "pattern": "^[A-Za-z][A-Za-z0-9]*$"
    },
    "package": {
      "type": "string",
      "description": "대상 앱 패키지. adb 소스에서 pid 자동추적에 쓴다."
    },
    "bufferSize": {
      "type": "integer",
      "minimum": 100,
      "maximum": 1000000,
      "default": 20000,
      "description": "서버 링버퍼 크기(줄). 대시보드 집계 범위와 같다."
    },
    "tabs": {
      "type": "array",
      "description": "도메인 탭. 원클릭 필터.",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "domains": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z0-9_]+$"
            },
            "description": "이 탭이 모을 도메인들 (태그의 prefix_ 뒷부분)."
          },
          "legacyTagPattern": {
            "type": "string",
            "description": "아직 이관 안 된 레거시 태그도 같은 탭에 끌어오기 위한 정규식. 점진 도입용."
          }
        }
      }
    },
    "issueRules": {
      "type": "array",
      "description": "이슈 트레이 규칙. 무엇을 이슈로 볼지 + 어떻게 그룹핑할지.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "when"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "fatal",
              "error",
              "warn",
              "info"
            ],
            "default": "error"
          },
          "when": {
            "type": "object",
            "description": "레코드 속성 → 정규식. 전부 만족해야 매치(AND).",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "type": "string"
              },
              "level": {
                "type": "string"
              },
              "tag": {
                "type": "string"
              },
              "domain": {
                "type": "string"
              },
              "event": {
                "type": "string"
              },
              "msg": {
                "type": "string"
              },
              "raw": {
                "type": "string"
              }
            }
          },
          "group": {
            "type": "object",
            "description": "그룹 키 생성. regex(raw 첫 캡처그룹) 또는 template({domain}/{event}, {f_필드명}).",
            "additionalProperties": false,
            "properties": {
              "regex": {
                "type": "string"
              },
              "fallback": {
                "type": "string"
              },
              "template": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "funnels": {
      "type": "array",
      "description": "세션 퍼널. flowId 필드가 있으면 흐름 단위, 없으면 단순 카운트로 근사.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "domain",
          "steps"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "domain": {
            "type": "string",
            "pattern": "^[A-Z0-9_]+$"
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 2
          }
        }
      }
    },
    "outcome": {
      "type": "object",
      "description": "이벤트 이름 접미사로 성공/실패 판정. 이름 거버넌스(기획서 §9-4)의 보상.",
      "additionalProperties": false,
      "properties": {
        "success": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "failure": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reasonFields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "실패 사유를 읽을 필드 우선순위."
        }
      }
    },
    "trees": {
      "type": "array",
      "description": "계층 로그를 트리로 다시 세우는 규칙. 조직도·주소록처럼 펼칠 때마다 불러오는 화면용. 각 줄에 자기 부모가 적혀 있어야 한다.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "domain"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "domain": {
            "type": "string",
            "pattern": "^[A-Z0-9_]+$"
          },
          "events": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "이 이벤트만 사용. 비우면 도메인 전체."
          },
          "node": {
            "type": "string",
            "default": "id",
            "description": "노드 식별자가 든 필드 이름"
          },
          "parent": {
            "type": "string",
            "default": "parent",
            "description": "부모 식별자가 든 필드 이름. node 와 같은 ID 체계여야 한다."
          },
          "name": {
            "type": "string",
            "description": "화면에 보여줄 이름 필드 (선택)"
          },
          "metrics": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "노드 옆에 같이 표시할 숫자 필드"
          },
          "childCount": {
            "type": "string",
            "description": "자식이 몇 개여야 하는지 앱이 알려주는 필드(예: subDept). 실제로 본 자식 수와 비교해 '아직 안 펼친 개수'를 보여준다."
          },
          "depthField": {
            "type": "string",
            "description": "앱이 적어 준 깊이 필드(예: depth). 트리는 parent 로만 세우고 이건 검증에만 쓴다. 어긋나면 parent 가 잘못 들어오고 있다는 신호."
          },
          "scope": {
            "type": "string",
            "description": "최상위 컨테이너가 여럿일 때 서로 섞이지 않게 나누는 필드(예: orgId). 없으면 전부 한 묶음."
          },
          "leaf": {
            "type": "object",
            "additionalProperties": false,
            "description": "말단에 붙는 다른 종류의 노드(예: 부서 아래의 사람). 같은 대상이 여러 부모에 나올 수 있어 부모+식별자를 키로 쓴다.",
            "properties": {
              "events": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "node": {
                "type": "string"
              },
              "parent": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "truncatedEvent": {
                "type": "string",
                "description": "수가 많아 일부를 로그에 안 남겼을 때의 이벤트"
              },
              "truncatedCount": {
                "type": "string",
                "description": "안 남긴 수가 든 필드"
              }
            }
          }
        }
      }
    },
    "tables": {
      "type": "array",
      "description": "목록처럼 쏟아지는 로그(서버 설정 항목 등)를 묶음별 표로 모으는 규칙. 로그 목록에서는 묶음마다 한 줄로 접히고, 누르면 표와 묶음 비교가 열린다.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "domain",
          "events"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "domain": {
            "type": "string",
            "pattern": "^[A-Z0-9_]+$"
          },
          "events": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "표로 묶을 이벤트"
          },
          "key": {
            "type": "string",
            "default": "code",
            "description": "행을 가르는 필드. 한 묶음 안에서 같은 값이 여러 번 나와도 된다. 비교는 이 필드 단위로 한다."
          },
          "groupBy": {
            "type": "string",
            "description": "한 묶음을 가르는 필드(예: flowId). 없으면 전부 한 묶음."
          },
          "countEvent": {
            "type": "string",
            "description": "앱이 '몇 개 보냈다'를 찍는 이벤트(예: RULE_SUMMARY). 묶음이 다 남아 있는지 판단하는 근거."
          },
          "countField": {
            "type": "string",
            "description": "countEvent 에서 개수가 든 필드(예: count)"
          },
          "catalog": {
            "type": "array",
            "description": "앱이 처리하도록 구현해 둔 key 목록. 목록에 있는데 이번 묶음에 안 들어온 것은 꺼진 상태로 보인다. 값 유무와 무관하게 '들어왔나'를 본다.",
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "required": [
                    "code"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string",
                      "description": "화면에 같이 보일 이름"
                    },
                    "note": {
                      "type": "string",
                      "description": "상세 창에 보일 메모 (예: 값 없이 수신만으로 동작)"
                    },
                    "type": {
                      "enum": [
                        "int",
                        "bool",
                        "url",
                        "json",
                        "kv"
                      ],
                      "description": "값의 기대 형식. 다르면 문제로 표시한다"
                    },
                    "pattern": {
                      "type": "string",
                      "description": "값이 통째로 맞아야 하는 정규식"
                    },
                    "keys": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "K=V 목록에 있어야 할 키"
                    },
                    "field": {
                      "type": "string",
                      "default": "value1",
                      "description": "검사할 필드"
                    },
                    "required": {
                      "type": "boolean",
                      "description": "비어 있으면(-) 문제로 본다. 기본은 비어 있어도 괜찮다 — 들어오기만 해도 동작하는 항목이 있다"
                    },
                    "where": {
                      "type": "string",
                      "description": "앱 소스 위치(파일:줄). 보통 catalogSource 가 채운다"
                    }
                  }
                }
              ]
            }
          },
          "labelFrom": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "event",
              "field"
            ],
            "description": "묶음을 사람이 알아볼 이름으로 부른다. 같은 묶음 값(groupBy)을 가진 다른 이벤트에서 필드를 읽는다(예: LOGIN_START 의 uid).",
            "properties": {
              "event": {
                "type": "string"
              },
              "field": {
                "type": "string"
              }
            }
          },
          "catalogSource": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "root",
              "pattern"
            ],
            "description": "구현 목록을 앱 소스에서 뽑는 규칙. 뷰어가 뜰 때마다 다시 훑는다. 같은 줄의 // 주석을 이름으로 쓴다. 손으로 적은 catalog 는 그 위에 덮어쓴다.",
            "properties": {
              "root": {
                "type": "string",
                "description": "앱 소스 루트"
              },
              "pattern": {
                "type": "string",
                "description": "캡처그룹 1 이 key 인 정규식. 예: \"(FEAT_[A-Z0-9_]+)\""
              },
              "include": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": [
                  "*.java",
                  "*.kt"
                ],
                "description": "훑을 파일 이름 글롭"
              }
            }
          },
          "sourceLink": {
            "type": "string",
            "description": "catalog 의 위치(파일:줄)를 여는 링크 틀. {abs} {path} {line} 을 채운다. 예: vscode://file{abs}:{line} ({abs} 가 / 로 시작한다)"
          }
        }
      }
    },
    "snapshotDir": {
      "type": "string",
      "description": "표 묶음을 파일로 남길 폴더(예: ~/.loglens/snapshots/my-app). 비우면 남기지 않는다. 남기면 뷰어를 다시 켜도 지난 묶음과 비교할 수 있다."
    },
    "eventSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "open"
      ],
      "description": "로그 한 줄 → 그 로그를 만든 코드 줄. 로그 줄의 ↗ 를 누르면 뷰어 서버가 open 명령으로 연다. 도우미 메서드로 감싼 경우 호출부까지 한 단계 따라간다.",
      "properties": {
        "root": {
          "type": "string",
          "description": "앱 소스 루트"
        },
        "open": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "여는 명령 인자 목록. {abs} {path} {line} 을 채운다. 예: [\"/Applications/Android Studio.app/Contents/MacOS/studio\", \"--line\", \"{line}\", \"{abs}\"]"
        },
        "pattern": {
          "type": "string",
          "description": "찍는 호출에서 이벤트 이름을 잡는 정규식(캡처그룹 1). 비우면 LogLens.i(도메인, \"이벤트\", …)"
        },
        "include": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "*.java",
            "*.kt"
          ]
        }
      }
    },
    "flow": {
      "type": "object",
      "additionalProperties": false,
      "description": "흐름 타임라인. 같은 값을 가진 로그를 한 흐름으로 잇는다.",
      "properties": {
        "field": {
          "type": "string",
          "default": "flowId",
          "description": "흐름을 잇는 필드"
        },
        "labelField": {
          "type": "string",
          "default": "uid",
          "description": "흐름 이름으로 보여줄 필드"
        }
      }
    },
    "naming": {
      "type": "object",
      "additionalProperties": false,
      "description": "이벤트 사전의 이름 검사.",
      "properties": {
        "synonyms": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 2
          },
          "description": "같은 뜻인데 이름이 다른 필드 묶음(예: [\"uid\", \"userId\"]). 대소문자·밑줄만 다른 것은 적지 않아도 잡는다."
        }
      }
    }
  }
}
