{
  "$schema": "../config.schema.json",
  "prefix": "APP",
  "package": "io.loglens.sample",
  "bufferSize": 20000,
  "tabs": [
    {
      "id": "auth",
      "label": "인증",
      "domains": [
        "AUTH"
      ],
      "legacyTagPattern": "(?i)login|auth|session"
    },
    {
      "id": "chat",
      "label": "채팅",
      "domains": [
        "CHAT"
      ],
      "legacyTagPattern": "(?i)chat|room|msg"
    },
    {
      "id": "net",
      "label": "네트워크",
      "domains": [
        "NET",
        "API2"
      ],
      "legacyTagPattern": "(?i)okhttp|retrofit"
    },
    {
      "id": "file",
      "label": "파일",
      "domains": [
        "FILE_XFER"
      ]
    }
  ],
  "issueRules": [
    {
      "id": "crash",
      "label": "크래시",
      "severity": "fatal",
      "when": {
        "tag": "^AndroidRuntime$",
        "raw": "[\\w.$]+(?:Exception|Error)\\b"
      },
      "group": {
        "regex": "([\\w.$]+(?:Exception|Error))\\b",
        "fallback": "UnknownCrash"
      }
    },
    {
      "id": "anr",
      "label": "ANR",
      "severity": "fatal",
      "when": {
        "raw": "\\bANR in\\b"
      },
      "group": {
        "regex": "ANR in ([^\\s(]+)",
        "fallback": "ANR"
      }
    },
    {
      "id": "native",
      "label": "네이티브 크래시",
      "severity": "fatal",
      "when": {
        "tag": "^(DEBUG|libc)$",
        "raw": "signal \\d+|Fatal signal"
      },
      "group": {
        "regex": "(signal \\d+[^,]*)",
        "fallback": "native"
      }
    },
    {
      "id": "structured_error",
      "label": "구조화 에러",
      "severity": "error",
      "when": {
        "kind": "^structured$",
        "level": "^E$"
      },
      "group": {
        "template": "{domain}/{event}"
      }
    }
  ],
  "funnels": [
    {
      "id": "login",
      "label": "로그인",
      "domain": "AUTH",
      "steps": [
        "LOGIN_START",
        "CREDENTIAL_CHECK",
        "TOKEN_ISSUE",
        "PROFILE_FETCH",
        "LOGIN_OK"
      ]
    }
  ],
  "outcome": {
    "success": [
      "_OK",
      "_SUCCESS",
      "_DONE"
    ],
    "failure": [
      "_FAIL",
      "_ERROR",
      "_TIMEOUT",
      "_DENIED"
    ],
    "reasonFields": [
      "reason",
      "err",
      "code"
    ]
  },
  "trees": [
    {
      "id": "org",
      "label": "조직도",
      "domain": "ORG",
      "events": [
        "NODE_FETCH_OK"
      ],
      "node": "node",
      "parent": "parent",
      "name": "title",
      "metrics": [
        "children",
        "items"
      ],
      "childCount": "children",
      "depthField": "depth"
    }
  ],
  "tables": [
    {
      "id": "rules",
      "label": "서버 설정",
      "domain": "AUTH",
      "events": [
        "RULE_ITEM"
      ],
      "key": "code",
      "groupBy": "flowId",
      "countEvent": "RULE_SUMMARY",
      "countField": "count",
      "catalog": [
        {
          "code": "FEAT_CHAT_1",
          "name": "채팅 최대 인원"
        },
        {
          "code": "FEAT_CHAT_2",
          "name": "채팅방 입퇴장 알림"
        },
        {
          "code": "FEAT_FILE_1",
          "name": "첨부 최대 크기(MB)",
          "type": "int"
        },
        {
          "code": "FEAT_FILE_2",
          "name": "첨부 허용 확장자"
        },
        {
          "code": "FEAT_ORG_1",
          "name": "조직도 탭"
        },
        {
          "code": "FEAT_URL_1",
          "name": "공지 링크",
          "type": "url"
        },
        {
          "code": "FEAT_UI_1",
          "name": "화면 옵션"
        },
        {
          "code": "FEAT_OPT",
          "name": "세부 옵션 (여러 개)",
          "keys": [
            "TYPE",
            "SECTION",
            "IDENT",
            "VALUE"
          ]
        },
        {
          "code": "FEAT_STATE_1",
          "name": "자리 비움 상태"
        },
        {
          "code": "FEAT_EMPTY_1",
          "name": "익명 채팅",
          "note": "값 없이 들어오기만 하면 켜진다"
        },
        {
          "code": "FEAT_EMPTY_2",
          "name": "읽음 표시 숨김",
          "note": "값 없이 들어오기만 하면 켜진다"
        },
        {
          "code": "FEAT_OFF_1",
          "name": "화상회의",
          "note": "서버가 보내야 메뉴가 생긴다"
        }
      ],
      "labelFrom": {
        "event": "LOGIN_START",
        "field": "uid"
      },
      "catalogSource": {
        "root": "loglens/sources",
        "pattern": "\"(FEAT_[A-Z0-9_]+)\"",
        "include": [
          "*.py"
        ]
      },
      "sourceLink": "vscode://file{abs}:{line}"
    }
  ]
}
